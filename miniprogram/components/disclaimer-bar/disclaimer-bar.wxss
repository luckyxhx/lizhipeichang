.bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(96rpx + env(safe-area-inset-bottom));
  margin: 0;
  padding: 0 24rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--color-border);
  border-radius: 0;
  color: var(--color-text-secondary);
  background: rgba(255, 255, 255, 0.98);
  font-size: 26rpx;
  line-height: 1.4;
}

.bar-pressed {
  background: var(--color-primary-soft);
}

.bar-mark {
  width: 10rpx;
  height: 10rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.overlay {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: rgba(10, 32, 29, 0.42);
}

.sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 82vh;
  padding: 34rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  box-sizing: border-box;
  background: var(--color-surface);
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow {
  color: var(--color-primary-strong);
  font-size: 24rpx;
  font-weight: 700;
}

.sheet-title {
  margin-top: 8rpx;
  color: var(--color-text);
  font-size: 40rpx;
  font-weight: 800;
}

.close {
  min-height: 88rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: var(--radius-control);
  color: var(--color-text-secondary);
  background: var(--color-surface-subtle);
  font-size: 25rpx;
  line-height: 88rpx;
}

.sheet-body {
  max-height: 54vh;
  margin-top: 28rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
