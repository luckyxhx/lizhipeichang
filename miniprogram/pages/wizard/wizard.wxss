.progress-head {
  padding: 4rpx 4rpx 28rpx;
}

.progress-copy {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.progress-step {
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 800;
}

.progress-label {
  color: var(--color-primary-strong);
  font-size: 25rpx;
  font-weight: 700;
}

.step-rail {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
  margin-top: 22rpx;
}

.step-node {
  text-align: center;
}

.step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto;
  border: 2rpx solid var(--color-border-strong);
  border-radius: 50%;
  color: var(--color-text-muted);
  background: var(--color-surface);
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.step-text {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.step-node-done .step-dot {
  border-color: var(--color-primary);
  color: var(--color-primary-strong);
  background: var(--color-primary-soft);
}

.step-node-active .step-dot {
  border-color: var(--color-primary);
  color: #ffffff;
  background: var(--color-primary);
}

.step-node-active .step-text {
  color: var(--color-primary-strong);
  font-weight: 700;
}

.form-card {
  padding: 40rpx 32rpx 34rpx;
}

.section-head {
  margin-bottom: 34rpx;
}

.section-helper {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.reason-list {
  margin-top: 28rpx;
}

.reason-item {
  display: flex;
  align-items: center;
  min-height: 94rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-control);
  background: var(--color-surface);
  transition:
    border-color 160ms ease-out,
    background-color 160ms ease-out;
}

.reason-item-active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.reason-content {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.reason-label {
  color: var(--color-text);
  font-size: 27rpx;
  line-height: 1.5;
}

.reason-tag {
  flex: 0 0 auto;
  margin-left: 14rpx;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-pill);
  color: var(--color-primary-strong);
  background: var(--color-surface);
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.choice-row {
  display: flex;
  gap: 20rpx;
}

.choice {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-control);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  transition:
    border-color 160ms ease-out,
    background-color 160ms ease-out;
}

.choice-active {
  border-color: var(--color-primary);
  color: var(--color-primary-strong);
  background: var(--color-primary-soft);
  font-weight: 700;
}

.prompt-card {
  margin-top: 8rpx;
  padding: 26rpx;
  border: 1rpx solid #bfe4de;
  border-radius: var(--radius-control);
  background: var(--color-primary-soft);
}

.prompt-title {
  color: var(--color-primary-strong);
  font-size: 27rpx;
  font-weight: 800;
}

.prompt-copy {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.65;
}

.prompt-button {
  min-height: 88rpx;
  margin-top: 22rpx;
  font-size: 26rpx;
}

.error-box {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #fecaca;
  border-radius: var(--radius-control);
  color: var(--color-danger);
  background: var(--color-danger-soft);
  font-size: 25rpx;
  line-height: 1.55;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 42rpx;
}

.action-back {
  width: 224rpx;
}

.action-next {
  flex: 1;
}
