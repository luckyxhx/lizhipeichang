.progress-head {
  padding: 8rpx 4rpx 28rpx;
}

.progress-step {
  color: #111827;
  font-size: 29rpx;
  font-weight: 800;
}

.progress-label {
  float: right;
  color: #ad234c;
  font-size: 27rpx;
  font-weight: 700;
}

.progress-track {
  height: 12rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 99rpx;
  background: #e5e7eb;
}

.progress-fill {
  height: 100%;
  border-radius: 99rpx;
  background: #e64c78;
  transition: width 0.25s ease;
}

.form-card {
  padding: 40rpx 32rpx 34rpx;
}

.reason-list {
  margin-top: 28rpx;
}

.reason-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  margin-bottom: 16rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #d6d3d1;
  border-radius: 16rpx;
  background: #ffffff;
}

.reason-item-active {
  border-color: #e64c78;
  background: #fff1f5;
}

.reason-content {
  flex: 1;
  margin-left: 14rpx;
}

.reason-label {
  color: #374151;
  font-size: 27rpx;
  line-height: 1.5;
}

.reason-tag {
  margin-left: 12rpx;
  color: #9f1239;
  font-size: 22rpx;
  white-space: nowrap;
}

.choice-row {
  display: flex;
  gap: 20rpx;
}

.choice {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  border: 1rpx solid #d6d3d1;
  border-radius: 16rpx;
  color: #4b5563;
  background: #ffffff;
}

.choice-active {
  border-color: #e64c78;
  color: #ad234c;
  background: #fff1f5;
  font-weight: 700;
}

.error-box {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  color: #b91c1c;
  background: #fef2f2;
  font-size: 25rpx;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 42rpx;
}

.action-back {
  width: 220rpx;
  margin: 0;
}

.action-next {
  flex: 1;
  margin: 0;
}
