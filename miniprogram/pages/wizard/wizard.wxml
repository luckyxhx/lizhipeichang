<view class="page">
  <view class="progress-head">
    <view class="progress-copy">
      <text class="progress-step">第 {{step}} 步，共 5 步</text>
      <text class="progress-label">{{steps[step - 1]}}</text>
    </view>
    <view class="step-rail" aria-label="填写进度">
      <view
        wx:for="{{steps}}"
        wx:key="*this"
        class="step-node {{index + 1 === step ? 'step-node-active' : ''}} {{index + 1 < step ? 'step-node-done' : ''}}"
      >
        <view class="step-dot">{{index + 1}}</view>
        <text class="step-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="surface form-card">
    <block wx:if="{{step === 1}}">
      <view class="section-head">
        <text class="section-title">日期范围</text>
        <text class="section-helper">用于计算工作年限，离职日期必须晚于入职日期。</text>
      </view>
      <view class="field">
        <label class="field-label" for="startDate">入职日期<text class="field-required">*</text></label>
        <picker id="startDate" mode="date" value="{{form.startDate}}" bindchange="onStartDateChange">
          <view class="picker-box {{form.startDate ? '' : 'picker-placeholder'}}">
            {{form.startDate || '请选择入职日期'}}
          </view>
        </picker>
      </view>
      <view class="field">
        <label class="field-label" for="endDate">离职日期<text class="field-required">*</text></label>
        <picker id="endDate" mode="date" value="{{form.endDate}}" bindchange="onEndDateChange">
          <view class="picker-box {{form.endDate ? '' : 'picker-placeholder'}}">
            {{form.endDate || '请选择离职日期'}}
          </view>
        </picker>
      </view>
    </block>

    <block wx:if="{{step === 2}}">
      <view class="section-head">
        <text class="section-title">工资信息</text>
        <text class="section-helper">系统按实际月份计算平均工资，不需要填写月份明细。</text>
      </view>
      <view class="field">
        <label class="field-label" for="totalIncomeLast12Months">离职前 12 个月总收入<text class="field-required">*</text></label>
        <input
          id="totalIncomeLast12Months"
          class="input"
          type="digit"
          value="{{form.totalIncomeLast12Months}}"
          placeholder="例如 180000"
          bindinput="onIncomeInput"
        />
        <text class="field-hint">填写工资、奖金、津贴、补贴等货币性收入合计，单位：元。</text>
      </view>
      <view class="field">
        <label class="field-label" for="actualMonths">实际月份数<text class="field-required">*</text></label>
        <input
          id="actualMonths"
          class="input"
          type="digit"
          value="{{form.actualMonths}}"
          placeholder="例如 8"
          bindinput="onMonthsInput"
        />
        <text class="field-hint">不满 12 个月时填写实际月份，输入范围 1 到 12。</text>
      </view>
    </block>

    <block wx:if="{{step === 3}}">
      <view class="section-head">
        <text class="section-title">劳动合同履行地</text>
        <text class="section-helper">按省、地市、区县三级选择。封顶线保持空白，由你填写官方标准。</text>
      </view>
      <view class="field">
        <label class="field-label" for="regionCity">省 / 市 / 区县<text class="field-required">*</text></label>
        <picker
          id="regionCity"
          mode="multiSelector"
          range="{{regionPickerRange}}"
          value="{{regionPickerValue}}"
          bindcolumnchange="onRegionColumnChange"
          bindchange="onRegionChange"
        >
          <view class="picker-box {{form.regionCity ? '' : 'picker-placeholder'}}">
            {{form.regionCity || '请选择省 / 市 / 区县'}}
          </view>
        </picker>
      </view>
      <view class="field">
        <label class="field-label" for="capMonthlyWage">当地上年度职工月平均工资的 3 倍<text class="field-required">*</text></label>
        <input
          id="capMonthlyWage"
          class="input"
          type="digit"
          value="{{form.capMonthlyWage}}"
          placeholder="请输入三倍封顶线"
          bindinput="onCapInput"
        />
        <text class="field-hint">留空后请填写。不同地区统计口径和适用年度可能不同。</text>
      </view>
      <view class="prompt-card">
        <view class="prompt-title">不知道当地标准？</view>
        <view class="prompt-copy">
          复制查询提示词，粘贴到可用的大模型工具，查询当地人社局或统计局公布的官方数据。
        </view>
        <button
          class="secondary-button prompt-button"
          hover-class="secondary-button-pressed"
          bindtap="copyLocalStandardPrompt"
        >
          复制当地标准查询提示词
        </button>
      </view>
    </block>

    <block wx:if="{{step === 4}}">
      <view class="section-head">
        <text class="section-title">解除情形</text>
        <text class="section-helper">选择最接近事实发生的情形，解除主体和证据会影响结论。</text>
      </view>
      <radio-group class="reason-list" aria-label="离职原因" bindchange="onReasonChange">
        <label
          wx:for="{{reasonOptions}}"
          wx:key="value"
          class="reason-item {{form.terminationReason === item.value ? 'reason-item-active' : ''}}"
        >
          <radio
            value="{{item.value}}"
            checked="{{form.terminationReason === item.value}}"
            color="#0f766e"
          />
          <view class="reason-content">
            <text class="reason-label">{{item.label}}</text>
          </view>
          <text class="reason-tag">{{item.shortLabel}}</text>
        </label>
      </radio-group>
    </block>

    <block wx:if="{{step === 5}}">
      <view class="section-head">
        <text class="section-title">程序信息</text>
        <text class="section-helper">通知方式和合同形式会影响风险提示。</text>
      </view>
      <view class="field">
        <text class="field-label">公司是否提前 30 日书面通知？<text class="field-required">*</text></text>
        <radio-group class="choice-row" aria-label="公司是否提前三十日书面通知" bindchange="onNoticeChange">
          <label class="choice {{form.writtenNoticeProvided ? 'choice-active' : ''}}">
            <radio value="yes" checked="{{form.writtenNoticeProvided}}" color="#0f766e" />是
          </label>
          <label class="choice {{!form.writtenNoticeProvided ? 'choice-active' : ''}}">
            <radio value="no" checked="{{!form.writtenNoticeProvided}}" color="#0f766e" />否
          </label>
        </radio-group>
      </view>

      <view wx:if="{{selectedRule.isArticle40 && !form.writtenNoticeProvided}}" class="field">
        <label class="field-label" for="lastMonthSalary">上个月应发工资<text class="field-required">*</text></label>
        <input
          id="lastMonthSalary"
          class="input"
          type="digit"
          value="{{form.lastMonthSalary}}"
          placeholder="例如 12000"
          bindinput="onLastMonthSalaryInput"
        />
        <text class="field-hint">用于计算 +1 代通知金，不是 12 个月平均工资。</text>
      </view>

      <view class="field">
        <text class="field-label">是否签订书面劳动合同？<text class="field-required">*</text></text>
        <radio-group class="choice-row" aria-label="是否签订书面劳动合同" bindchange="onContractChange">
          <label class="choice {{form.hasWrittenContract ? 'choice-active' : ''}}">
            <radio value="yes" checked="{{form.hasWrittenContract}}" color="#0f766e" />是
          </label>
          <label class="choice {{!form.hasWrittenContract ? 'choice-active' : ''}}">
            <radio value="no" checked="{{!form.hasWrittenContract}}" color="#0f766e" />否
          </label>
        </radio-group>
      </view>
    </block>

    <view wx:if="{{error}}" class="error-box" aria-role="alert" aria-label="{{error}}">
      {{error}}
    </view>

    <view class="actions">
      <button
        class="secondary-button action-back"
        hover-class="secondary-button-pressed"
        bindtap="previous"
      >
        上一步
      </button>
      <button
        class="primary-button action-next"
        hover-class="primary-button-pressed"
        bindtap="next"
      >
        {{step === 5 ? '生成估算报告' : '下一步'}}
      </button>
    </view>
  </view>
</view>

<disclaimer-bar />
