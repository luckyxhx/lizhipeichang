.amount-card {
  padding: 42rpx 36rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: #111827;
}

.amount-kicker {
  display: block;
  color: #ffd1df;
  font-size: 25rpx;
  font-weight: 700;
}

.amount-label {
  display: block;
  margin-top: 28rpx;
  color: #cbd5e1;
  font-size: 25rpx;
}

.amount-value {
  display: block;
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.3;
}

.amount-note {
  display: block;
  margin-top: 18rpx;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.6;
}

.amount-conclusion {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #e2e8f0;
  font-size: 25rpx;
  line-height: 1.65;
}

.conclusion-card,
.section-card {
  margin-top: 26rpx;
  padding: 34rpx 30rpx;
}

.conclusion-card {
  background: #fff1f5;
}

.card-kicker {
  color: #ad234c;
  font-size: 23rpx;
  font-weight: 700;
}

.rule-title {
  margin-top: 10rpx;
  color: #111827;
  font-size: 46rpx;
  font-weight: 900;
}

.card-copy {
  margin-top: 18rpx;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 1.7;
}

.section-heading {
  color: #111827;
  font-size: 33rpx;
  font-weight: 800;
}

.section-subtitle {
  margin-top: 12rpx;
  color: #7c8491;
  font-size: 23rpx;
  line-height: 1.55;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0ecec;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  width: 210rpx;
  color: #6b7280;
  font-size: 25rpx;
}

.detail-value {
  flex: 1;
  color: #111827;
  font-size: 25rpx;
  font-weight: 700;
  text-align: right;
}

.source-item {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  background: #f8fafc;
}

.source-title,
.source-note {
  display: block;
}

.source-title {
  color: #1f2937;
  font-size: 25rpx;
  font-weight: 700;
}

.source-note {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.legal-item {
  margin-top: 30rpx;
  padding-left: 22rpx;
  border-left: 6rpx solid #f2c8d5;
}

.legal-title,
.legal-copy {
  display: block;
}

.legal-title {
  color: #111827;
  font-size: 26rpx;
  font-weight: 700;
}

.legal-copy {
  margin-top: 10rpx;
  color: #5f6673;
  font-size: 24rpx;
  line-height: 1.65;
}

.risk-card {
  margin-top: 26rpx;
  padding: 34rpx 30rpx;
  border: 1rpx solid #f6d99a;
  border-radius: 16rpx;
  background: #fff8e6;
}

.risk-item {
  display: flex;
  margin-top: 20rpx;
  color: #713f12;
  font-size: 24rpx;
  line-height: 1.65;
}

.risk-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 15rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #d97706;
}

.check-item {
  display: flex;
  margin-top: 24rpx;
  color: #4b5563;
  font-size: 25rpx;
  line-height: 1.6;
}

.check-item checkbox {
  margin-right: 14rpx;
}

.disclaimer-card {
  margin-top: 26rpx;
  padding: 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  color: #6b7280;
  background: #f8fafc;
  font-size: 22rpx;
  line-height: 1.7;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 30rpx;
}

.restart-button {
  min-height: 86rpx;
  border: 1rpx solid #d6d3d1;
  border-radius: 16rpx;
  color: #4b5563;
  background: #ffffff;
  font-size: 27rpx;
  line-height: 86rpx;
}
