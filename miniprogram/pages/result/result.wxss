.amount-card {
  position: relative;
  overflow: hidden;
  padding: 40rpx 34rpx 36rpx;
  border-radius: var(--radius-card);
  color: #ffffff;
  background: #123f3a;
  box-shadow: 0 20rpx 46rpx rgba(15, 63, 58, 0.22);
}

.amount-card::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 8rpx;
  background: var(--color-accent);
  content: "";
}

.amount-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.amount-kicker {
  color: #d7f3ee;
  font-size: 25rpx;
  font-weight: 700;
}

.amount-status {
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: var(--radius-pill);
  color: #e8fffb;
  font-size: 22rpx;
}

.amount-label {
  display: block;
  margin-top: 28rpx;
  color: #b7d5d1;
  font-size: 25rpx;
}

.amount-value {
  display: block;
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

.amount-note {
  display: block;
  margin-top: 18rpx;
  color: #b7d5d1;
  font-size: 24rpx;
  line-height: 1.6;
}

.amount-conclusion {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #f0fffd;
  font-size: 25rpx;
  line-height: 1.65;
}

.report-intro {
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-control);
  color: var(--color-text-secondary);
  background: var(--color-surface-subtle);
  font-size: 24rpx;
  line-height: 1.65;
}

.report-intro-label {
  display: block;
  margin-bottom: 8rpx;
  color: var(--color-primary-strong);
  font-size: 23rpx;
  font-weight: 800;
}

.conclusion-card,
.section-card {
  margin-top: 24rpx;
  padding: 32rpx 30rpx;
}

.conclusion-card {
  border-color: #bfe4de;
  background: var(--color-primary-soft);
}

.card-kicker {
  color: var(--color-primary-strong);
  font-size: 24rpx;
  font-weight: 700;
}

.rule-title {
  margin-top: 10rpx;
  color: var(--color-text);
  font-size: 46rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.card-copy {
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.7;
}

.section-heading {
  color: var(--color-text);
  font-size: 33rpx;
  font-weight: 800;
}

.section-subtitle {
  margin-top: 12rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label {
  width: 220rpx;
  color: var(--color-text-muted);
  font-size: 25rpx;
}

.detail-value {
  flex: 1;
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 700;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.source-item {
  display: block;
  width: 100%;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-control);
  box-sizing: border-box;
  color: var(--color-text);
  background: var(--color-surface-subtle);
  line-height: 1.5;
  text-align: left;
}

.source-title,
.source-note {
  display: block;
}

.source-title {
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 700;
}

.source-note {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.legal-item {
  margin-top: 30rpx;
  padding-left: 22rpx;
  border-left: 6rpx solid #9fd6cc;
}

.legal-title,
.legal-copy {
  display: block;
}

.legal-title {
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 700;
}

.legal-copy {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.7;
}

.risk-card {
  margin-top: 24rpx;
  padding: 32rpx 30rpx;
  border: 2rpx solid #f4d58b;
  border-radius: var(--radius-card);
  background: var(--color-warning-soft);
}

.risk-item {
  display: flex;
  margin-top: 20rpx;
  color: #713f12;
  font-size: 24rpx;
  line-height: 1.7;
}

.risk-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 15rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--color-warning);
}

.check-item {
  display: flex;
  min-height: 88rpx;
  margin-top: 12rpx;
  padding: 10rpx 0;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.65;
}

.check-item checkbox {
  margin-right: 14rpx;
}

.disclaimer-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-control);
  color: var(--color-text-muted);
  background: var(--color-surface-subtle);
  font-size: 23rpx;
  line-height: 1.7;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 30rpx;
}

.restart-button {
  min-height: 92rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: var(--radius-control);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  font-size: 27rpx;
  line-height: 1.4;
}
