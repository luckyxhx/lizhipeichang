.hero {
  position: relative;
  overflow: hidden;
  padding: 42rpx 36rpx 38rpx;
}

.hero-rule {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 8rpx;
  background: var(--color-primary);
}

.hero-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-eyebrow {
  color: var(--color-primary-strong);
  font-size: 25rpx;
  font-weight: 700;
}

.hero-badge {
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  color: var(--color-primary-strong);
  background: var(--color-primary-soft);
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 22rpx;
  color: var(--color-text);
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.18;
  font-variant-numeric: tabular-nums;
}

.hero-copy {
  margin-top: 22rpx;
  color: var(--color-text-secondary);
  font-size: 29rpx;
  line-height: 1.7;
}

.flow-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 34rpx;
  padding: 20rpx;
  border-radius: var(--radius-control);
  background: var(--color-surface-subtle);
}

.flow-item {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  text-align: center;
}

.flow-index {
  display: block;
  margin-bottom: 8rpx;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 800;
}

.hero-button {
  margin-top: 34rpx;
}

.price-note {
  margin-top: 16rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  text-align: center;
}

.section-label {
  margin: 38rpx 4rpx 16rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
}

.feature-list {
  padding: 4rpx 30rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.feature-item:last-child {
  border-bottom: 0;
}

.feature-index {
  width: 58rpx;
  margin-right: 18rpx;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.7;
  font-variant-numeric: tabular-nums;
}

.feature-content {
  flex: 1;
}

.feature-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.feature-copy {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.65;
}

.notice {
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  border-left: 8rpx solid var(--color-warning);
  border-radius: 0 var(--radius-control) var(--radius-control) 0;
  color: #713f12;
  background: var(--color-warning-soft);
  font-size: 24rpx;
  line-height: 1.7;
}
